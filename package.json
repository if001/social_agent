{
  "name": "social-agent-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:system": "vitest run --config vitest.system.config.ts --passWithNoTests",
    "test:evaluation": "vitest run --config vitest.evaluation.config.ts --passWithNoTests",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm test:system"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.6.5"
  }
}
