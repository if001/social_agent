{
  "name": "social-agent-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:system": "vitest run --config vitest.system.config.ts --passWithNoTests",
    "test:evaluation": "vitest run --config vitest.evaluation.config.ts --passWithNoTests",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm test:system",
    "ops": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-zod": "^0.8.3",
    "eslint": "^9.36.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@langchain/ollama": "1.3.0",
    "deepagents": "1.14.1",
    "discord.js": "14.27.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.7",
    "langchain": "1.5.15",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
