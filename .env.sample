BOT_ID=ao
# Omit to use config/personas/<BOT_ID>.yaml when that file exists.
BOT_PERSONA_FILE=

# Legacy single-channel setting; DISCORD_CHANNEL_IDS takes precedence.
DISCORD_CHANNEL_ID=1461247669602222180
DISCORD_CHANNEL_IDS=1461247669602222180
DISCORD_OWNER_IDS=
DISCORD_GUILD_IDS=
DISCORD_BOT_USER_ID=1461245597443948557
DISCORD_QUEUE_DESTINATION=discord:ao
DEFAULT_OUTPUT_DESTINATION=discord:ao

# Discord-User
DISCORD_BOT_TOKEN=
# URL取り込み専用プロセスも同じ設定を使用する。専用channelのenv fileで
# `pnpm page-ingest:start --env-file .env.page-ingest` のように起動する。

# Web tools backend
SIMPLE_CLIENT_BASE_URL=http://172.22.1.29:8000
# Bot間で共有するWeb page raw Markdownの保存先
WEB_ARCHIVE_ROOT=./var/web-archive
# file_read/file_list/file_find/file_grepで参照を許可するroot。複数指定はcomma区切り
FILE_READ_ROOTS=./var/files
# file_write/file_deleteで変更を許可するroot。複数指定はcomma区切り
FILE_WRITE_ROOTS=./var/files

# Postgres
POSTGRES_URL=postgresql://app_user:app_pw@localhost:5432/appdb
# Postgres for migration
ADMIN_POSTGRES_URL=postgresql://admin:admin@localhost:5432/appdb
# Shared database for integration tests.  DDL/migration uses TEST_ADMIN_POSTGRES_URL;
# repository and runtime tests use TEST_POSTGRES_URL.
TEST_POSTGRES_URL=postgresql://app_user:app_pw@localhost:5432/appdb_test
TEST_ADMIN_POSTGRES_URL=postgresql://admin:admin@localhost:5432/appdb_test
# Must match both TEST_*_POSTGRES_URL database names and end with `_test`.
TEST_DATABASE_NAME=appdb_test

# Ollama
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=kimi-k2.6:cloud
OLLAMA_EMBEDDING_BASE_URL=http://172.22.1.29:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
OLLAMA_EMBEDDING_DIMENSION=768

# Runtime loops
RUN_DEADLINE_MS=120000
# correlation loop防止recordの保持期間（604800000 = 7日）
RUNTIME_CORRELATION_TTL_MS=604800000
# rate-limit windowの監査猶予を含む保持期間（3600000 = 1時間）
RUNTIME_RATE_WINDOW_RETENTION_MS=3600000
# 因果関係を持つ配送の最大hop数。循環を機械的に停止する（既定5、1〜32）
RUNTIME_MAX_HOPS=5
# Schedulerが期限到来済みの処理をDBから探す間隔
SCHEDULER_INTERVAL_MS=30000
# idle Event（自律探索・自発発話）を再検討する間隔（86400000 = 24h）
AUTONOMY_REVIEW_INTERVAL_MS=86400000
# Concern formation（関心地図の形成）を再検討する間隔（86400000 = 24h）
CONCERN_FORMATION_INTERVAL_MS=86400000
# 夜間にidle Eventを発生させない時間帯（HH:MM-HH:MM、未設定なら停止しない）
AUTONOMY_IDLE_QUIET_HOURS=23:00-07:00
AUTONOMY_IDLE_QUIET_TIME_ZONE=Asia/Tokyo
# Reflection（経験を長期状態へ統合）を実行する間隔（86400000 = 24h）
STATE_REVIEW_INTERVAL_MS=86400000
# Reflectionで長期間扱われなかったactive Concernをabandonedへ閉じる閾値（2592000000 = 30日）
CONCERN_STALE_AFTER_MS=2592000000
# stale判定前に、そのConcernが入力として提示される最低Reflection Session数
CONCERN_STALE_MIN_REFLECTION_SESSIONS=2
# Scheduler処理が失敗した場合に再試行するまでの待ち時間
SCHEDULER_RETRY_DELAY_MS=300000
# 複数processによる同じScheduleの重複取得を防ぐlease時間
SCHEDULER_LEASE_MS=60000
# 未配送Outboxを配送する間隔
OUTBOX_INTERVAL_MS=1000
