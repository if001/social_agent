BOT_ID=ao
BOT_FAMILY_ID=default
# Omit to use config/personas/<BOT_ID>.yaml when that file exists.
BOT_PERSONA_FILE=

# Legacy single-channel setting; DISCORD_CHANNEL_IDS takes precedence.
DISCORD_CHANNEL_ID=1461247669602222180
DISCORD_CHANNEL_IDS=1461247669602222180
DISCORD_OWNER_IDS=
DISCORD_GUILD_IDS=
DISCORD_BOT_USER_ID=1461245597443948557
DISCORD_QUEUE_DESTINATION=discord:ao
DEFAULT_OUTPUT_DESTINATION=discord:ao

# Discord-User
DISCORD_BOT_TOKEN=

# Web tools backend
SIMPLE_CLIENT_BASE_URL=http://172.22.1.29:8000
# Bot間で共有するWeb page raw Markdownの保存先
WEB_ARCHIVE_ROOT=./var/web-archive

# Postgres
POSTGRES_URL=postgresql+psycopg://app_user:app_pw@172.22.1.29:5433/appdb
# Postgres for migration
ADMIN_POSTGRES_URL=postgresql+psycopg://admin:admin@172.22.1.29:5433/appdb

# Ollama
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=kimi-k2.6:cloud
OLLAMA_EMBEDDING_BASE_URL=http://172.22.1.29:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
OLLAMA_EMBEDDING_DIMENSION=768

# Runtime loops
RUN_DEADLINE_MS=120000
# Schedulerが期限到来済みの処理をDBから探す間隔
SCHEDULER_INTERVAL_MS=30000
# Self・Drive・Current Interestから自律行動を再検討する間隔
AUTONOMY_REVIEW_INTERVAL_MS=86400000
# Mood・Drive・Current Interestの持続状態を再評価する間隔
STATE_REVIEW_INTERVAL_MS=86400000
# 現在状態に関連するMemoryを自発的に想起する間隔
MEMORY_RECALL_INTERVAL_MS=604800000
# Triggerを持たないActive Intentionを再評価する間隔(86400000 = 24h)
INTENTION_REVIEW_INTERVAL_MS=86400000
# 新しいDriveを保存してから最初に自律再検討するまでの待ち時間
PERSISTENT_DRIVE_INITIAL_DELAY_MS=0
# 継続中のDriveを再検討する間隔
PERSISTENT_DRIVE_REVIEW_INTERVAL_MS=86400000
# Scheduler処理が失敗した場合に再試行するまでの待ち時間
SCHEDULER_RETRY_DELAY_MS=300000
# 複数processによる同じScheduleの重複取得を防ぐlease時間
SCHEDULER_LEASE_MS=60000
# 未配送Outboxと応答後Post-processを確認する間隔
OUTBOX_INTERVAL_MS=1000
